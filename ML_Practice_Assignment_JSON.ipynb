      "source": [
        "# Machine Learning Practice Assignment with JSON\n",
        "This assignment demonstrates how to track progress using JSON files."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Example: Reading progress from JSON\n",
        "import json\n",
        "\n",
        "# Load the JSON file\n",
        "with open('neuro_assistant_data.json', 'r') as file:\n",
        "    data = json.load(file)\n",
        "\n",
        "# Display a user's progress\n",
        "username = 'example_user'\n",
        "if username in data['progress']:\n",
        "    progress = data['progress'][username]\n",
        "    print(f"Lectures completed: {len(progress['lectures_completed'])}")\n",
        "    print(f"Quizzes completed: {len(progress['quizzes_completed'])}")"
      ]
    }
  ]
